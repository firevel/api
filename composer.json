{
    "name": "firevel/api",
    "description": "A Laravel package offering base classes for efficient RESTful API development.",
    "keywords": ["laravel", "firevel", "api"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Slowik",
            "email": "michael.slowik@firevel.com"
        }
    ],
    "require": {
        "firevel/filterable": "^0.0.16",
        "firevel/firebase-authentication": "^3.0.0",
        "firevel/includes": "^0.0.1",
        "firevel/sortable": "^0.1.0",
        "spatie/laravel-fractal": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Firevel\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firevel\\Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firevel\\Api\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
